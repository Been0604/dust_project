# --------------------------------------------------
# 1. 설정 / 민감정보
# --------------------------------------------------

# 실제 키 들어있는 로컬 설정 (깃에 올리면 안 되는 것들)
config/*secret*
config/*local*
config/*.env
config/api_keys*.yml

# 샘플 설정파일은 추적하고 싶으면, 이름을 이렇게 두면 됨:
#   config/config_example.yml  ← 이건 ignore 안 됨

# --------------------------------------------------
# 2. 대용량 / 재생성 가능한 데이터
# --------------------------------------------------

data/
features/
models/
reports/figures/
reports/qgis/
reports/bi/

# 필요한 경우, 최종 보고서 PDF만 남기고 싶으면:
#   reports/final_report/ 는 따로 두고, 위 패턴에 안 걸리게 구성

# 바이너리/중간 산출물
*.parquet
*.joblib
*.pkl
*.zip
*.7z
*.log

# --------------------------------------------------
# 3. 파이썬 캐시 / 노트북
# --------------------------------------------------

__pycache__/
*.pyc
.ipynb_checkpoints/

# --------------------------------------------------
# 4. 기타 환경 파일
# --------------------------------------------------

*.env
